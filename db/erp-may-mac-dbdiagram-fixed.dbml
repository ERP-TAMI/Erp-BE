Enum record_status {
  active
  inactive
}

Enum po_status {
  draft
  pending_rd
  in_progress
  closed
  cancelled
}

Enum product_status {
  draft
  in_review
  sampling
  closed
  cancelled
}

Enum style_status {
  draft
  active
}

Enum sample_status {
  working
  needs_revision
  approved
}

Enum production_doc_status {
  draft
  in_progress
  completed
}

Enum upload_status {
  pending
  ready
  failed
  quarantined
}

Enum document_purpose {
  po_original
  tech_pack
  material_pdf
  sample_image
  translation
  color_card
  production_doc
  avatar
  other
}

Enum bom_status {
  draft
  wait_rd
  wait_tpkh_confirm
  wait_accounting
  wait_sa_approve
  closed
}

Enum notification_channel {
  in_app
  email
}

Enum notification_delivery_status {
  pending
  sent
  failed
  skipped
}

Enum audit_event_type {
  created
  updated
  deleted
  status_changed
  approved
  rejected
  document_linked
  document_unlinked
  document_version_added
  copied
  synced
  login
  password_changed
  role_changed
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar(255) [not null]
  password_hash varchar(255) [not null]
  full_name varchar(200) [not null]
  phone varchar(20)
  avatar_url varchar(500)
  status record_status [not null, default: `'active'`]
  must_change_password boolean [not null, default: `true`]
  login_failed_count integer [not null, default: `0`]
  lockout_until timestamptz
  last_login_at timestamptz
  row_version bigint [not null, default: `1`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (email) [unique]
  }
}

Table roles {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(30) [not null, unique]
  name varchar(100) [not null]
  description text
  is_system boolean [not null, default: `false`]
}

Table permissions {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(100) [not null, unique]
  description text [not null]
}

Table user_roles {
  user_id uuid [not null]
  role_id uuid [not null]
  assigned_at timestamptz [not null, default: `now()`]
  assigned_by uuid
  indexes {
    (user_id, role_id) [pk]
  }
}

Table role_permissions {
  role_id uuid [not null]
  permission_id uuid [not null]
  indexes {
    (role_id, permission_id) [pk]
  }
}

Table customers {
  id uuid [pk, default: `gen_random_uuid()`]
  customer_code varchar(50) [not null, unique]
  customer_name varchar(255) [not null]
  status record_status [not null, default: `'active'`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table material_groups {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(50) [not null, unique]
  name varchar(150) [not null]
  status record_status [not null, default: `'active'`]
}

Table units {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(30) [not null, unique]
  name varchar(100) [not null]
  decimal_scale smallint [not null, default: `4`]
  status record_status [not null, default: `'active'`]
}

Table materials {
  id uuid [pk, default: `gen_random_uuid()`]
  material_code varchar(100) [not null, unique]
  material_name varchar(255) [not null]
  material_group_id uuid
  default_unit_id uuid
  status record_status [not null, default: `'active'`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table stages {
  id uuid [pk, default: `gen_random_uuid()`]
  stage_code varchar(50) [not null, unique]
  stage_name varchar(255) [not null]
  description text
  default_ssv numeric(12,3) [not null, default: `0`]
  status record_status [not null, default: `'active'`]
}

Table documents {
  id uuid [pk, default: `gen_random_uuid()`]
  document_code varchar(100)
  title varchar(500) [not null]
  current_version_id uuid
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  archived_at timestamptz
  indexes {
    (document_code) [unique]
  }
}

Table document_versions {
  id uuid [pk, default: `gen_random_uuid()`]
  document_id uuid [not null]
  version_no integer [not null]
  original_file_name varchar(500) [not null]
  storage_key varchar(1000) [not null, unique]
  mime_type varchar(255) [not null]
  byte_size bigint [not null]
  sha256 char(64)
  status upload_status [not null, default: `'pending'`]
  change_reason text
  uploaded_by uuid
  uploaded_at timestamptz [not null, default: `now()`]
  indexes {
    (document_id, version_no) [unique]
  }
}

Table document_folders {
  id uuid [pk, default: `gen_random_uuid()`]
  parent_id uuid
  folder_name varchar(255) [not null]
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (parent_id, folder_name) [unique]
  }
}

Table folder_documents {
  folder_id uuid [not null]
  document_id uuid [not null]
  linked_at timestamptz [not null, default: `now()`]
  linked_by uuid
  indexes {
    (folder_id, document_id) [pk]
  }
}

Table styles {
  id uuid [pk, default: `gen_random_uuid()`]
  style_code varchar(100) [not null, unique]
  style_name varchar(255) [not null]
  description text
  category varchar(100)
  status style_status [not null, default: `'draft'`]
  base_image_version_id uuid
  as3b_cm_base_days integer [not null, default: `30`]
  row_version bigint [not null, default: `1`]
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_by uuid
  updated_at timestamptz [not null, default: `now()`]
}

Table style_documents {
  style_id uuid [not null]
  document_id uuid [not null]
  purpose document_purpose [not null, default: `'other'`]
  linked_by uuid
  linked_at timestamptz [not null, default: `now()`]
  indexes {
    (style_id, document_id) [pk]
  }
}

Table style_operation_steps {
  id uuid [pk, default: `gen_random_uuid()`]
  style_id uuid [not null]
  parent_step_id uuid
  stage_id uuid
  step_name varchar(255) [not null]
  description text
  time_per_piece numeric(12,3) [not null, default: `0`]
  ssv numeric(12,3) [not null, default: `0`]
  target_total integer [not null, default: `0`]
  note text
  order_index integer [not null]
  is_group boolean [not null, default: `false`]
  indexes {
    (style_id, order_index) [unique]
  }
}

Table style_sample_rounds {
  id uuid [pk, default: `gen_random_uuid()`]
  style_id uuid [not null]
  round_no integer [not null]
  sample_date date
  feedback text
  status sample_status [not null, default: `'working'`]
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  reviewed_by uuid
  reviewed_at timestamptz
  indexes {
    (style_id, round_no) [unique]
  }
}

Table style_sample_images {
  id uuid [pk, default: `gen_random_uuid()`]
  sample_round_id uuid [not null]
  document_version_id uuid [not null]
  color_name varchar(100)
  order_index integer [not null, default: `0`]
}

Table draft_bom_families {
  id uuid [pk, default: `gen_random_uuid()`]
  style_id uuid [not null]
  bom_code varchar(100) [not null, unique]
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
}

Table draft_bom_versions {
  id uuid [pk, default: `gen_random_uuid()`]
  family_id uuid [not null]
  parent_version_id uuid
  version_no integer [not null]
  change_reason text
  is_current boolean [not null, default: `false`]
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (family_id, version_no) [unique]
  }
}

Table draft_bom_lines {
  id uuid [pk, default: `gen_random_uuid()`]
  version_id uuid [not null]
  material_id uuid
  material_name_snapshot varchar(255) [not null]
  material_group_id uuid
  unit_id uuid
  consumption numeric(18,6) [not null]
  note text
  order_index integer [not null]
  indexes {
    (version_id, order_index) [unique]
  }
}

Table purchase_orders {
  id uuid [pk, default: `gen_random_uuid()`]
  po_code varchar(50) [not null, unique]
  customer_po_code varchar(100)
  customer_id uuid [not null]
  customer_name_snapshot varchar(255) [not null]
  received_date date [not null]
  note text
  status po_status [not null, default: `'draft'`]
  cancellation_reason text
  closed_at timestamptz
  closed_by uuid
  row_version bigint [not null, default: `1`]
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_by uuid
  updated_at timestamptz [not null, default: `now()`]
  archived_at timestamptz
}

Table purchase_order_status_history {
  id uuid [pk, default: `gen_random_uuid()`]
  purchase_order_id uuid [not null]
  old_status po_status
  new_status po_status [not null]
  action varchar(50) [not null]
  reason text
  changed_by uuid
  changed_at timestamptz [not null, default: `now()`]
}

Table purchase_order_documents {
  purchase_order_id uuid [not null]
  document_id uuid [not null]
  purpose document_purpose [not null, default: `'other'`]
  linked_by uuid
  linked_at timestamptz [not null, default: `now()`]
  indexes {
    (purchase_order_id, document_id) [pk]
  }
}

Table purchase_order_products {
  id uuid [pk, default: `gen_random_uuid()`]
  purchase_order_id uuid [not null]
  source_style_id uuid
  product_code varchar(100) [not null]
  product_name varchar(255) [not null]
  category varchar(100)
  material_note text
  deadline date
  structure_image_version_id uuid
  status product_status [not null, default: `'draft'`]
  previous_status product_status
  cancellation_reason text
  closed_at timestamptz
  closed_by uuid
  row_version bigint [not null, default: `1`]
  as3b_cm_base_days integer [not null, default: `30`]
  imported_at timestamptz
  imported_by uuid
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_by uuid
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (purchase_order_id, product_code) [unique]
  }
}

Table purchase_order_product_status_history {
  id uuid [pk, default: `gen_random_uuid()`]
  product_id uuid [not null]
  old_status product_status
  new_status product_status [not null]
  action varchar(50) [not null]
  reason text
  changed_by uuid
  changed_at timestamptz [not null, default: `now()`]
}

Table purchase_order_product_documents {
  product_id uuid [not null]
  document_id uuid [not null]
  source_po_document boolean [not null, default: `false`]
  purpose document_purpose [not null, default: `'other'`]
  linked_by uuid
  linked_at timestamptz [not null, default: `now()`]
  indexes {
    (product_id, document_id) [pk]
  }
}

Table purchase_order_product_colors {
  id uuid [pk, default: `gen_random_uuid()`]
  product_id uuid [not null]
  color_name varchar(100) [not null]
  color_code varchar(50)
  order_index integer [not null, default: `0`]
  indexes {
    (product_id, color_name) [unique]
  }
}

Table purchase_order_product_color_sizes {
  id uuid [pk, default: `gen_random_uuid()`]
  product_color_id uuid [not null]
  size_label varchar(30) [not null]
  quantity integer [not null]
  order_index integer [not null, default: `0`]
  indexes {
    (product_color_id, size_label) [unique]
  }
}

Table purchase_order_product_operation_steps {
  id uuid [pk, default: `gen_random_uuid()`]
  product_id uuid [not null]
  source_style_step_id uuid
  parent_step_id uuid
  stage_id uuid
  step_name varchar(255) [not null]
  description text
  time_per_piece numeric(12,3) [not null, default: `0`]
  ssv numeric(12,3) [not null, default: `0`]
  target_total integer [not null, default: `0`]
  note text
  order_index integer [not null]
  is_group boolean [not null, default: `false`]
  indexes {
    (product_id, order_index) [unique]
  }
}

Table purchase_order_product_sample_rounds {
  id uuid [pk, default: `gen_random_uuid()`]
  product_id uuid [not null]
  source_style_sample_round_id uuid
  round_no integer [not null]
  sample_date date
  feedback text
  status sample_status [not null, default: `'working'`]
  row_version bigint [not null, default: `1`]
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  reviewed_by uuid
  reviewed_at timestamptz
  indexes {
    (product_id, round_no) [unique]
  }
}

Table purchase_order_product_sample_images {
  id uuid [pk, default: `gen_random_uuid()`]
  sample_round_id uuid [not null]
  product_color_id uuid
  document_version_id uuid [not null]
  color_name_snapshot varchar(100)
  order_index integer [not null, default: `0`]
}

Table product_color_cards {
  id uuid [pk, default: `gen_random_uuid()`]
  product_color_id uuid [not null, unique]
  current_version_id uuid
  created_at timestamptz [not null, default: `now()`]
}

Table product_color_card_versions {
  id uuid [pk, default: `gen_random_uuid()`]
  color_card_id uuid [not null]
  version_no integer [not null]
  document_version_id uuid [not null]
  replacement_reason text
  uploaded_by uuid
  uploaded_at timestamptz [not null, default: `now()`]
  indexes {
    (color_card_id, version_no) [unique]
  }
}

Table production_documents {
  id uuid [pk, default: `gen_random_uuid()`]
  style_id uuid
  product_id uuid
  name varchar(255) [not null]
  description text
  status production_doc_status [not null, default: `'draft'`]
  source_document_id uuid
  row_version bigint [not null, default: `1`]
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_by uuid
  updated_at timestamptz [not null, default: `now()`]
}

Table production_document_sections {
  id uuid [pk, default: `gen_random_uuid()`]
  production_document_id uuid [not null]
  section_code varchar(40) [not null]
  title varchar(255) [not null]
  content text
  order_index integer [not null]
  is_fixed boolean [not null, default: `false`]
  indexes {
    (production_document_id, order_index) [unique]
    (production_document_id, section_code) [unique]
  }
}

Table production_document_size_rows {
  id uuid [pk, default: `gen_random_uuid()`]
  production_document_id uuid [not null]
  size_label varchar(30) [not null]
  measurement_name varchar(255) [not null]
  measurement_value varchar(100)
  tolerance varchar(100)
  order_index integer [not null, default: `0`]
}

Table production_document_images {
  id uuid [pk, default: `gen_random_uuid()`]
  section_id uuid [not null]
  group_heading varchar(255)
  heading_color varchar(30)
  document_version_id uuid [not null]
  group_order integer [not null, default: `0`]
  image_order integer [not null, default: `0`]
}

Table production_document_revisions {
  id uuid [pk, default: `gen_random_uuid()`]
  production_document_id uuid [not null]
  revision_no integer [not null]
  action varchar(30) [not null]
  source_document_id uuid
  reason text
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (production_document_id, revision_no) [unique]
  }
}

Table idempotency_keys {
  id uuid [pk, default: `gen_random_uuid()`]
  scope varchar(100) [not null]
  idempotency_key varchar(200) [not null]
  request_hash char(64) [not null]
  response_code integer
  resource_id uuid
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (scope, idempotency_key) [unique]
  }
}

Table material_sizes {
  id uuid [pk, default: `gen_random_uuid()`]
  material_id uuid [not null]
  size_code varchar(20) [not null]
  barcode varchar(50)
  unit_cost numeric(18,2) [not null, default: `0`]
  current_stock numeric(18,4) [not null, default: `0`]
  low_stock_threshold numeric(18,4) [not null, default: `10`]
  status record_status [not null, default: `'active'`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (material_id, size_code) [unique]
    (barcode) [unique]
  }
}

Table stage_groups {
  id uuid [pk, default: `gen_random_uuid()`]
  group_code varchar(50) [not null, unique]
  group_name varchar(255) [not null]
  description text
  status record_status [not null, default: `'active'`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table stage_group_items {
  stage_group_id uuid [not null]
  stage_id uuid [not null]
  order_index integer [not null]
  name_snapshot varchar(255) [not null]
  description_snapshot text
  ssv_snapshot numeric(12,3) [not null]
  indexes {
    (stage_group_id, stage_id) [pk]
    (stage_group_id, order_index) [unique]
  }
}

Table workshops {
  id uuid [pk, default: `gen_random_uuid()`]
  workshop_code varchar(50) [not null, unique]
  name varchar(255) [not null]
  manager varchar(200)
  location varchar(255)
  daily_capacity integer [not null, default: `0`]
  status record_status [not null, default: `'active'`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table size_charts {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(100) [not null, unique]
  status record_status [not null, default: `'active'`]
  revision_no integer [not null, default: `1`]
  supersedes_id uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table size_chart_items {
  id uuid [pk, default: `gen_random_uuid()`]
  size_chart_id uuid [not null]
  size_label varchar(30) [not null]
  order_index integer [not null]
  indexes {
    (size_chart_id, size_label) [unique]
    (size_chart_id, order_index) [unique]
  }
}

Table bills_of_materials {
  id uuid [pk, default: `gen_random_uuid()`]
  bom_code varchar(100) [not null, unique]
  product_color_id uuid [not null, unique]
  product_code_snapshot varchar(100) [not null]
  product_name_snapshot varchar(255) [not null]
  color_name_snapshot varchar(100) [not null]
  po_code_snapshot varchar(50) [not null]
  order_quantity_snapshot integer [not null]
  deadline timestamptz
  status bom_status [not null, default: `'draft'`]
  rd_note text
  approved_by uuid
  approved_at timestamptz
  row_version bigint [not null, default: `1`]
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_by uuid
  updated_at timestamptz [not null, default: `now()`]
}

Table bill_of_material_lines {
  id uuid [pk, default: `gen_random_uuid()`]
  bill_of_material_id uuid [not null]
  material_id uuid [not null]
  material_name_snapshot varchar(255) [not null]
  material_group_snapshot varchar(100)
  unit_snapshot varchar(50) [not null]
  consumption_per_unit numeric(18,6)
  unit_cost numeric(18,2)
  order_index integer [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (bill_of_material_id, material_id) [unique]
    (bill_of_material_id, order_index) [unique]
  }
}

Table bill_of_material_status_history {
  id uuid [pk, default: `gen_random_uuid()`]
  bill_of_material_id uuid [not null]
  old_status bom_status
  new_status bom_status [not null]
  action varchar(50) [not null]
  reason text
  changed_by uuid
  changed_at timestamptz [not null, default: `now()`]
}

Table production_plans {
  id uuid [pk, default: `gen_random_uuid()`]
  product_id uuid [not null]
  workshop_id uuid
  plan_month smallint [not null]
  plan_year smallint [not null]
  planned_quantity integer [not null]
  start_date date
  end_date date
  note text
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (product_id, workshop_id, plan_year, plan_month) [unique]
  }
}

Table production_plan_days {
  id uuid [pk, default: `gen_random_uuid()`]
  production_plan_id uuid [not null]
  plan_date date [not null]
  planned_quantity integer [not null, default: `0`]
  actual_quantity integer [not null, default: `0`]
  is_manual_override boolean [not null, default: `false`]
  indexes {
    (production_plan_id, plan_date) [unique]
  }
}

Table user_sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  refresh_token_hash char(64) [not null, unique]
  user_agent varchar(500)
  ip_address inet
  expires_at timestamptz [not null]
  revoked_at timestamptz
  revoke_reason text
  created_at timestamptz [not null, default: `now()`]
}

Table notification_catalog {
  id uuid [pk, default: `gen_random_uuid()`]
  event_code varchar(100) [not null, unique]
  event_group varchar(50) [not null]
  display_name varchar(255) [not null]
  default_in_app boolean [not null, default: `true`]
  default_email boolean [not null, default: `false`]
  is_active boolean [not null, default: `true`]
}

Table notification_catalog_roles {
  notification_catalog_id uuid [not null]
  role_id uuid [not null]
  indexes {
    (notification_catalog_id, role_id) [pk]
  }
}

Table notification_preferences {
  user_id uuid [not null]
  notification_catalog_id uuid [not null]
  in_app_enabled boolean [not null]
  email_enabled boolean [not null]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, notification_catalog_id) [pk]
  }
}

Table notifications {
  id uuid [pk, default: `gen_random_uuid()`]
  recipient_user_id uuid [not null]
  notification_catalog_id uuid [not null]
  title varchar(255) [not null]
  body text [not null]
  entity_type varchar(80)
  entity_id uuid
  created_at timestamptz [not null, default: `now()`]
  read_at timestamptz
}

Table notification_deliveries {
  id uuid [pk, default: `gen_random_uuid()`]
  notification_id uuid [not null]
  channel notification_channel [not null]
  status notification_delivery_status [not null, default: `'pending'`]
  attempt_count integer [not null, default: `0`]
  last_error text
  next_attempt_at timestamptz
  sent_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (notification_id, channel) [unique]
  }
}

Table outbox_events {
  id uuid [pk, default: `gen_random_uuid()`]
  aggregate_type varchar(80) [not null]
  aggregate_id uuid [not null]
  event_type varchar(100) [not null]
  payload jsonb [not null]
  occurred_at timestamptz [not null, default: `now()`]
  published_at timestamptz
  attempt_count integer [not null, default: `0`]
  last_error text
}

Table audit_events {
  id uuid [pk, default: `gen_random_uuid()`]
  occurred_at timestamptz [not null, default: `now()`]
  actor_user_id uuid
  actor_identifier varchar(255)
  aggregate_type varchar(80) [not null]
  aggregate_id uuid [not null]
  parent_id uuid
  event_type audit_event_type [not null]
  actor_role varchar(30)
  target_label varchar(500)
  reason text
  correlation_id uuid
  request_id varchar(100)
}

Table audit_event_changes {
  id bigint [pk]
  audit_event_id uuid [not null]
  field_name varchar(150) [not null]
  old_value jsonb
  new_value jsonb
}

