APP_PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=55432
DB_NAME=erp
DB_USER=erp
DB_PASS=erp
DB_AUTO_CONNECT=false

JWT_SECRET=change-me-in-local-env
# Access token TTL (short-lived by design, OWASP recommendation). Refresh token TTL is fixed at 7 days (see auth.constants.ts).
JWT_EXPIRY=15m

# Password for the 6 seeded test accounts (npm run seed:auth). Set locally / in CI secrets only, never commit a real value.
SEED_TEST_ACCOUNT_PASSWORD=

AWS_S3_REGION=ap-southeast-1
AWS_S3_BUCKET=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=

MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
